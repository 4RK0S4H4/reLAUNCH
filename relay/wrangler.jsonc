{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relaunch",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pc/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PC_HUB", "class_name": "PcHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PcHub"] }],
  "observability": { "enabled": true }
}
