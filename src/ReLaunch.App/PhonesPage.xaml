<Page
    x:Class="ReLaunch.App.PhonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Phones" />
            <InfoBar x:Name="Info" IsOpen="False" IsClosable="False" Severity="Warning" />

            <Grid ColumnSpacing="24" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="220" Height="220" CornerRadius="8" Background="White">
                    <Image x:Name="QrImage" Stretch="Uniform" Margin="8" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Pair a Phone" />
                    <TextBlock x:Name="PairHelp" TextWrapping="Wrap" Opacity="0.8" Text="Open the reLAUNCH web app on your phone and scan this code with the camera. Each code works once and expires after 5 minutes." />
                    <TextBlock x:Name="CodeText" Style="{StaticResource TitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="UrlText" Opacity="0.7" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ExpiryText" Opacity="0.7" />
                    <Button x:Name="PairButton" Content="Pair a Phone" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Paired Phones" />
            <StackPanel x:Name="DeviceList" Spacing="8" />
            <TextBlock x:Name="NoDevices" Opacity="0.7" Text="No phones are paired yet." Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
