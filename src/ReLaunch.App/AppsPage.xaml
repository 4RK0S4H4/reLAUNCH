<Page
    x:Class="ReLaunch.App.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Apps" />
            <TextBlock x:Name="ErrorText" Grid.Row="1" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Row="2" PlaceholderText="Search apps" QueryIcon="Find" />
            <Pivot x:Name="Tabs" Grid.Row="3">
                <PivotItem Header="All Apps">
                    <ListView x:Name="AllList" SelectionMode="Single" />
                </PivotItem>
                <PivotItem Header="Favorites">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Drag to change the order shown on your phone." Opacity="0.7" />
                        <ListView x:Name="FavList" Grid.Row="1" SelectionMode="Single" CanReorderItems="True" CanDragItems="True" AllowDrop="True" />
                    </Grid>
                </PivotItem>
            </Pivot>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Details" Spacing="12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="56" Height="56" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Image x:Name="DetailIcon" Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailStatus" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="StartButton" Content="Start" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="RestartButton" Content="Restart" />
                    <Button x:Name="StopButton" Content="Stop" />
                </StackPanel>
                <TextBlock x:Name="ActionMessage" TextWrapping="Wrap" Opacity="0.8" />

                <TextBlock Text="Overrides" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
                <TextBox x:Name="ArgsBox" Header="Launch arguments" PlaceholderText="None" />
                <TextBox x:Name="ExtraBox" Header="Extra process names" PlaceholderText="helper, tray (comma separated)" />
                <NumberBox x:Name="CloseBox" Header="Close timeout (ms)" Minimum="500" Maximum="60000" Value="5000" SmallChange="500" LargeChange="2000" SpinButtonPlacementMode="Compact" />
                <Button x:Name="SaveButton" Content="Save Overrides" />
                <TextBlock x:Name="SaveMessage" Opacity="0.8" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
